# FinGoal-AI Backend Environment Variables Template
# Copy this file to .env and customize the values for your environment.

# Application Environment
ENVIRONMENT=development
PROJECT_NAME="FinGoal-AI"
API_V1_STR="/api/v1"

# Database Configuration (PostgreSQL)
# Format: postgresql://<user>:<password>@<host>:<port>/<dbname>
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/fingoal_db

# Security & JWT Authentication
# Generate a secure secret key using: openssl rand -hex 32
SECRET_KEY=replace-with-a-secure-random-32-byte-hex-key-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# CORS Configuration
# Comma-separated list or JSON array of origins
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# AI Recommendations (LLM Service)
# Rule-based fallback is automatically used if LLM_API_KEY is not configured
LLM_PROVIDER=gemini
LLM_API_KEY=
LLM_MODEL=gemini-1.5-flash

# File Upload Security Settings
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=15
ALLOWED_EXTENSIONS=["pdf","csv"]

